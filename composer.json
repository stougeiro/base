{
    "name": "stougeiro/base",
    "description": "",
    "type": "library",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "license": "MIT",
    "authors": [
        {
            "name": "stougeiro",
            "email": "sidneytougeiro@gmail.com"
        }
    ],
    "keywords": [
    ],
    "support": {
        "issues": "https://github.com/stougeiro/base/issues",
        "source": "https://github.com/stougeiro/base"
    },
    "funding": [
        {
            "type": "buymeacoffee",
            "url": "https://www.buymeacoffee.com/stougeiro"
        }
    ],
    "autoload": {
        "psr-4": {
            "Sourcerer\\": "src/"
        },
        "files": [
            "src/Env.php",
            "src/Config.php",
            "src/Error/Fallback.php"
        ]
    },
    "require": {
        "php": ">=8.2",
        "stougeiro/router-contract": "^2.1.0",
        "stougeiro/container": "^4.0",
        "stougeiro/http": "^2.2",
        "stougeiro/immutable": "^2.0",
        "stougeiro/view-contract": "^2.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "pestphp/pest": "^3.8",
        "stougeiro/router": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
